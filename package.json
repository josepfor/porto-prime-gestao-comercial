{
  "name": "construgest-desktop-standalone",
  "version": "4.4.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "desktop": "electron .",
    "build:win": "electron-packager . \"Porto Prime\" --platform=win32 --arch=x64 --out=dist --overwrite --prune=true",
    "build:portable": "electron-builder --win portable --x64",
    "build:setup": "electron-builder --win nsis --x64",
    "build:all": "electron-builder --win portable nsis --x64",
    "check:critical": "node scripts/check-critical-functions.cjs",
    "check:trial": "node scripts/check-trial-license.cjs",
    "build:update": "electron-builder --win nsis --x64 --config electron-builder-update.yml",
    "build:release": "npm run check:critical && npm run check:trial && npm run check:products && npm run check:quotes && npm run build:portable && npm run build:setup && npm run build:update",
    "check:products": "node scripts/check-products.mjs",
    "check:quotes": "node scripts/check-quote-search.cjs",
    "check:reports": "node scripts/check-management-report.mjs",
    "check:stability": "node scripts/check-stability-420.mjs",
    "check:server": "node scripts/check-server-integrity.cjs",
    "check:sale-idempotency": "node scripts/check-sale-idempotency.cjs",
    "check:stock-intelligence": "node scripts/check-stock-intelligence.mjs",
    "check:seller-performance": "node scripts/check-seller-performance.mjs",
    "check:data-directory": "node scripts/check-data-directory.cjs",
    "check:password-recovery": "node scripts/check-password-recovery.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "@electric-sql/pglite": "^0.3.8",
    "xlsx": "^0.18.5"
  },
  "main": "electron-main.cjs",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-packager": "^17.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.construgest.desktop",
    "productName": "Porto Prime",
    "asar": true,
    "files": [
      "electron-main.cjs",
      "package.json",
      "public/**/*",
      "src/**/*",
      ".env.example"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "PortoPrime-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Porto Prime",
      "artifactName": "PortoPrime-Setup-${version}-${arch}.${ext}",
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**/*"
    ],
    "publish": null
  },
  "description": "Porto Prime - Sistema de Gestão Comercial desktop standalone",
  "author": "Porto Prime"
}
